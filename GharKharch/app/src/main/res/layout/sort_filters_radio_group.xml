<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sortFiltersContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_large"
    android:layout_marginVertical="@dimen/margin_small"
    android:background="@drawable/rounded_panel"
    android:backgroundTint="@color/secondaryColor"
    android:gravity="end"
    android:orientation="vertical"
    android:visibility="gone">

    <RadioGroup
        android:id="@+id/sortFiltersRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/yearly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Sort By : Year"
            android:textSize="@dimen/text_size_medium" />

        <RadioButton
            android:id="@+id/quarterly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Sort By : Quarter"
            android:textSize="@dimen/text_size_medium" />

        <RadioButton
            android:id="@+id/monthly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Sort By : Month"
            android:textSize="@dimen/text_size_medium" />

        <RadioButton
            android:id="@+id/dateWise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Sort By : Date"
            android:textSize="@dimen/text_size_medium" />
    </RadioGroup>

    <Button
        android:id="@+id/confirmSortFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium"
        android:background="@drawable/rounded_panel"
        android:backgroundTint="@color/backgroundColorVariant"
        android:text="Ok" />

</LinearLayout>