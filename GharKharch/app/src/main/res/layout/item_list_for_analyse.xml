<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_list_for_analyse"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_large"
    android:background="@drawable/rounded_panel"
    android:backgroundTint="@color/secondaryColor"
    android:gravity="end"
    android:orientation="vertical"
    android:visibility="gone">

    <RadioGroup
        android:id="@+id/itemRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/categoriesRB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Categories"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/subCatRB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Expense Heads"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/expenseRB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Expense"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />
    </RadioGroup>

    <Button
        android:id="@+id/confirmBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_large"
        android:backgroundTint="@color/backgroundColorVariant"
        android:padding="@dimen/padding_medium"
        android:text="Ok" />

</LinearLayout>