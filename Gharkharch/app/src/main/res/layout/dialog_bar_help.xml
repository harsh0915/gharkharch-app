<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_panel"
    android:backgroundTint="@color/backgroundColor"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/zoom_instruction"
        android:textSize="@dimen/text_size_medium"
        android:lineSpacingExtra="@dimen/line_spacing_small"
        android:contentDescription="@string/zoom_instruction_desc"
        android:layout_marginBottom="@dimen/padding_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/switch_timeframe_instruction"
        android:textSize="@dimen/text_size_medium"
        android:lineSpacingExtra="@dimen/line_spacing_small"
        android:contentDescription="@string/switch_timeframe_instruction_desc"
        android:layout_marginBottom="@dimen/padding_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_details_instruction"
        android:textSize="@dimen/text_size_medium"
        android:lineSpacingExtra="@dimen/line_spacing_small"
        android:contentDescription="@string/view_details_instruction_desc"
        android:layout_marginBottom="@dimen/padding_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_instruction"
        android:textSize="@dimen/text_size_medium"
        android:lineSpacingExtra="@dimen/line_spacing_small"
        android:contentDescription="@string/reset_instruction_desc" />

</LinearLayout>
