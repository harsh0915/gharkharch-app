<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:paddingHorizontal="@dimen/padding_large">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:padding="@dimen/padding_medium"
        android:text="Date"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/date_picker"
        app:layout_constraintEnd_toStartOf="@id/date_picker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/date_picker" />

    <TextView
        android:id="@+id/date_picker"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:background="@drawable/rounded_border"
        android:padding="@dimen/padding_medium"
        android:text="15/02/2006"
        android:textColor="@color/primaryTextColor"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_small"
        android:padding="@dimen/padding_medium"
        android:text="Head"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/input_expense_name"
        app:layout_constraintEnd_toStartOf="@id/input_expense_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/input_expense_name" />

    <EditText
        android:id="@+id/input_expense_name"
        style="@style/custom_edit_text"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:hint="@string/hint_sub_category"
        android:importantForAutofill="no"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date_picker" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:text="Amount "
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/input_expense_amount"
        app:layout_constraintEnd_toStartOf="@id/input_expense_amount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/input_expense_amount" />

    <EditText
        android:id="@+id/input_expense_amount"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:background="@drawable/rounded_border"
        android:hint="@string/hint_amount"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="15"
        android:padding="@dimen/padding_medium"
        android:textColorHint="@color/primaryTextColorVariant"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/input_expense_name" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:text="Mode"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/modes_of_payment"
        app:layout_constraintEnd_toStartOf="@id/modes_of_payment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/modes_of_payment" />

    <!--    <Spinner-->
    <!--        android:id="@+id/modes_of_payment"-->
    <!--        android:layout_width="200dp"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_marginVertical="@dimen/margin_small"-->
    <!--        android:background="@drawable/rounded_border"-->
    <!--        android:entries="@array/modesOfPayment"-->
    <!--        android:padding="@dimen/padding_medium"-->
    <!--        android:spinnerMode="dialog"-->
    <!--        android:textColor="@color/primaryTextColorVariant"-->
    <!--        android:textStyle="bold"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
    <!--        app:layout_constraintTop_toBottomOf="@id/input_expense_amount" />-->

    <TextView
        android:id="@+id/modes_of_payment"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:background="@drawable/rounded_border"
        android:padding="@dimen/padding_medium"
        android:text="CASH"
        android:textColor="@color/primaryTextColor"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/input_expense_amount" />


    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:text="Remarks"
        android:textSize="@dimen/text_size_medium"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/input_expense_remarks"
        app:layout_constraintEnd_toStartOf="@id/input_expense_remarks"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/input_expense_remarks" />

    <EditText
        android:id="@+id/input_expense_remarks"
        style="@style/custom_edit_text"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:hint="@string/hint_expense_remark"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:maxLength="50"
        android:maxLines="3"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modes_of_payment" />

    <Button
        android:id="@+id/addBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_medium"
        android:layout_marginStart="@dimen/margin_small"
        android:backgroundTint="@color/buttonColor"
        android:text="Save"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/input_expense_remarks" />

    <Button
        android:id="@+id/cancelBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_large"
        android:layout_marginVertical="@dimen/margin_medium"
        android:backgroundTint="@color/red"
        android:text="Cancel"
        android:textSize="@dimen/text_size_medium"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/addBtn"
        app:layout_constraintTop_toBottomOf="@id/input_expense_remarks" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_sub_category_search_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_small"
        android:background="@drawable/rounded_panel"
        android:backgroundTint="@color/backgroundColor"
        android:clipToOutline="true"
        android:elevation="5dp"
        android:outlineProvider="background"
        android:translationZ="5dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/input_expense_name"
        app:layout_constraintStart_toStartOf="@id/input_expense_name"
        app:layout_constraintTop_toBottomOf="@id/input_expense_name" />

    <LinearLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:textSize="@dimen/text_size_medium"
        app:layout_constraintTop_toBottomOf="@id/addBtn">

        <TextView
            android:id="@+id/list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="@dimen/padding_large"
            android:text="Ledger"
            android:textSize="@dimen/text_size_medium" />

        <SearchView
            android:id="@+id/search_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/margin_medium"
            android:layout_weight="1"
            android:background="@drawable/search_bar_border"
            android:iconifiedByDefault="false"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:padding="@dimen/padding_large"
            android:src="@drawable/close_search_icon"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/show_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:padding="@dimen/padding_large"
            android:src="@drawable/calendar_icon" />

        <ImageView
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:padding="@dimen/padding_large"
            android:src="@drawable/search_icon" />

    </LinearLayout>

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_A_black"
        app:layout_constraintTop_toBottomOf="@id/list_container" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_expense_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="@dimen/margin_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/separator"
        app:layout_constraintStart_toStartOf="@id/list_container"
        app:layout_constraintTop_toBottomOf="@id/list_container" />

</androidx.constraintlayout.widget.ConstraintLayout>

