<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_xlarge"
        android:text="Settings"
        android:textColor="@color/primaryTextColor"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginVertical="@dimen/margin_small"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Profile"
            android:textColor="@color/primaryTextColor"
            android:textSize="@dimen/text_size_medium"
            app:drawableStartCompat="@drawable/profile_icon" />


        <TextView
            android:id="@+id/manage_expenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginVertical="@dimen/margin_small"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Manage Expenses"
            android:textSize="@dimen/text_size_medium"
            app:drawableStartCompat="@drawable/manage_expenses_icon" />

        <TextView
            android:id="@+id/analyse_expenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginVertical="@dimen/margin_small"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Analyse Expenses"
            android:textColor="@color/primaryTextColor"
            android:textSize="@dimen/text_size_medium"
            app:drawableStartCompat="@drawable/analyse_icon" />

        <TextView
            android:id="@+id/backup_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginVertical="@dimen/margin_small"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Backup Your Data"
            android:textColor="@color/primaryTextColor"
            android:textSize="@dimen/text_size_medium"
            app:drawableStartCompat="@drawable/backup_icon" />

        <TextView
            android:id="@+id/restore_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_small"
            android:layout_marginVertical="@dimen/margin_small"
            android:drawablePadding="@dimen/padding_large"
            android:padding="@dimen/padding_large"
            android:text="Restore Your Data"
            android:textColor="@color/primaryTextColor"
            android:textSize="@dimen/text_size_medium"
            app:drawableStartCompat="@drawable/restore_icon" />

    </LinearLayout>

</LinearLayout>