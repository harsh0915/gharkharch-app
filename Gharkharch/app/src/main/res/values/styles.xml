<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--    bottom navigation view-->
    <style name="bottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/iconColor</item>
    </style>

    <!--    bottom navigation indicator-->
    <style name="bottomNavigationViewIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/secondaryColor</item>
    </style>

    <style name="custom_edit_text" parent="Widget.AppCompat.EditText">
        <item name="android:maxLines">1</item>
        <item name="android:maxLength">20</item>
        <item name="android:ellipsize">end</item>
        <item name="android:inputType">textCapSentences</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:padding">@dimen/padding_medium</item>
        <item name="android:background">@drawable/rounded_border</item>
        <item name="android:textColorHint">@color/primaryTextColorVariant</item>
    </style>

    <style name="custom_date_picker" parent="@style/ThemeOverlay.Material3.MaterialCalendar">
        <!--bg of focused element and buttons-->
        <item name="colorPrimary">@color/secondaryColor</item>
        <!--text color on focused element-->
        <item name="colorOnPrimary">@color/white</item>
        <!--bg color on the whole pop up surface-->
        <item name="colorSecondary">@color/white</item>
        <!--text color on the whole pop up surface-->
        <item name="colorOnSurface">@color/primaryTextColor</item>
        <!--usually heading on the containers -->
        <item name="colorOnSurfaceVariant">@color/primaryTextColorVariant</item>
        <!--secondary container inside the main dialog could be the range highlighter in date range picker-->
        <item name="colorSecondaryContainer">@color/backgroundColorVariant</item>
        <item name="android:background">@color/backgroundColor</item>
        <item name="shapeCornerFamily">rounded</item>
    </style>

</resources>